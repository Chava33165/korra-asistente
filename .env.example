# Copia a .env y llena los valores:  cp .env.example .env && chmod 600 .env

# --- Rutas en la Pi ---
CETI_DIR=/home/usuario/Documentos/Escuela
# Archivos personales (nóminas, etc.): dentro de los contenedores se ven como /jarvis/archivos
PERSONAL_DIR=/home/usuario/Documentos/Personal
# Videos, diseños y presentaciones que no son de la escuela (dentro de los contenedores: /creaciones)
CREACIONES_DIR=/home/usuario/Documentos/Creaciones
SKILLS_DIR=/home/usuario/.claude/skills/synced/<id-de-tus-skills>
# Claude Code global de la Pi: el worker usa sus skills (lectura/escritura) y plugins (solo lectura)
CLAUDE_GLOBAL_DIR=/home/usuario/.claude
AGENTS_DIR=/home/usuario/.agents

# --- Telegram ---  (@BotFather → /newbot)
TELEGRAM_TOKEN=
# Tu chat id: arranca el bot, mándale /start y te lo dice (o usa @userinfobot)
ALLOWED_CHAT_ID=

# --- DeepSeek ---  (platform.deepseek.com → API keys)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Claude Code ---  (en la Pi: `claude setup-token`, usa tu suscripción Pro/Max)
CLAUDE_CODE_OAUTH_TOKEN=
# Vacío = modelo default de tu plan. Ej: claude-sonnet-5 / claude-opus-5-5
CLAUDE_MODEL=
JOB_TIMEOUT_S=1200
# Vacío = el SEMESTRE_N más alto
SEMESTRE_ACTUAL=

# --- Cloudflare Tunnel propio de este proyecto (Zero Trust → Tunnels) ---

# --- Personalidad / Jarvis ---
JARVIS_DIR=/home/usuario/KORRA
ASISTENTE_NOMBRE=Jarvis
# Horas (24 h, Guadalajara). Vacío = desactivado.
HORA_MANANA=08:00
HORA_NOCHE=22:00
HORA_REFLEXION=03:30

# --- Voz ---
# Transcripción de audios: console.groq.com → API Keys (gratis con límite diario)
GROQ_API_KEY=
# Voz de las respuestas: es-MX-JorgeNeural (hombre) o es-MX-DaliaNeural (mujer)
TTS_VOZ=es-MX-JorgeNeural
TTS_VELOCIDAD=+8%

# --- Google (Calendar, Gmail, Classroom) ---
# Alias de cuentas; se conectan desde Telegram con /google <alias>
GOOGLE_CUENTAS=escuela,personal,empleo
GOOGLE_CUENTA_CLASSROOM=escuela
GOOGLE_CALENDARIO_PRINCIPAL=personal
# Parcial por default (se cambia desde Telegram con /parcial 2)
PARCIAL_ACTUAL=P1

# --- Eventos de software en GDL (búsqueda diaria con Claude). Vacío = apagado ---
HORA_EVENTOS=01:00
DIAS_EVENTOS=lu,ju
HORA_AVISO_EVENTOS=08:10
MODELO_EVENTOS=claude-haiku-4-5

# --- Impresora (CUPS de la Pi) ---
IMPRESORA=HP_Smart_Tank
IMPRESORA_IP=192.168.1.140

# --- Dinero (task-hub) ---
# = BEARER_TOKEN de ~/Servicios/task-hub/.env. Vacío = el resumen de la mañana no habla de dinero.
FINANZAS_TOKEN=
